@page
@using System.Text.Json
@model DoQuangThang_SE1885_A01_FE.Pages.Analytics.IndexModel
@{
    ViewData["Title"] = "Analytics Dashboard";
}

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0 text-gray-800">📊 Dashboard Overview</h1>

        <form method="post" asp-page-handler="Export" class="d-inline">
            <input type="hidden" asp-for="StartDate" />
            <input type="hidden" asp-for="EndDate" />
            <button type="submit" class="btn btn-sm btn-success shadow-sm">
                <i class="bi bi-download"></i> Export Report
            </button>
        </form>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Filter Data</h6>
        </div>
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-2">
                    <label class="form-label fw-bold">From Date</label>
                    <input asp-for="StartDate" type="date" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold">To Date</label>
                    <input asp-for="EndDate" type="date" class="form-control" />
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-bold">Category</label>
                    <select asp-for="CategoryId" class="form-select">
                        <option value="">-- All Categories --</option>
                        @if (Model.Categories != null)
                        {
                            foreach (var cat in Model.Categories)
                            {
                                <option value="@cat.CategoryId">@cat.CategoryName</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-bold">Author</label>
                    <select asp-for="AuthorId" class="form-select">
                        <option value="">-- All Authors --</option>
                        @if (Model.Authors != null)
                        {
                            foreach (var auth in Model.Authors)
                            {
                                <option value="@auth.AuthorId">@auth.AuthorName</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-funnel"></i> Apply
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-xl-4 col-md-6">
            <div class="card border-left-primary shadow h-100 py-2 border-primary border-3 border-start">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Total Articles</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.DashboardData.TotalArticles</div>
                        </div>
                        <div class="col-auto">
                            <i class="bi bi-newspaper fs-2 text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-md-6">
            <div class="card border-left-success shadow h-100 py-2 border-success border-3 border-start">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Total Views</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.DashboardData.TotalViews</div>
                        </div>
                        <div class="col-auto">
                            <i class="bi bi-eye fs-2 text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-header">
                    Article Status Ratio
                </div>
                <div class="card-body">
                    <canvas id="statusChart" style="max-height: 250px;"></canvas>
                </div>
            </div>
        </div>

        @* <div class="col-xl-4 col-md-6">
            <div class="card border-left-info shadow h-100 py-2 border-info border-3 border-start">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Active Users</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.DashboardData.TotalActiveAccounts</div>
                        </div>
                        <div class="col-auto">
                            <i class="bi bi-people fs-2 text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div> *@
    </div>

    <div class="row mb-4">
        <div class="col-lg-5">
            <div class="card shadow mb-4 h-100">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Articles by Category</h6>
                </div>
                <div class="card-body">
                    <div class="chart-pie pt-4 pb-2">
                        <canvas id="myPieChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card shadow mb-4 h-100">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Articles Timeline</h6>
                </div>
                <div class="card-body">
                    <div class="chart-bar">
                        <canvas id="myBarChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-danger">🔥 Trending Articles (Top 10)</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover" width="100%" cellspacing="0">
                    <thead class="table-light">
                        <tr>
                            <th>Title</th>
                            <th>Category</th>
                            <th>Author</th>
                            <th>Views</th>
                            <th>Created Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.TrendingArticles != null && Model.TrendingArticles.Any())
                        {
                            foreach (var item in Model.TrendingArticles)
                            {
                                <tr>
                                    <td>@item.NewsTitle</td>
                                    <td><span class="badge bg-secondary">@item.CategoryName</span></td>
                                    <td>@item.AuthorName</td>
                                    <td class="fw-bold text-primary">@item.Views</td>
                                    <td>@item.CreatedDate.ToString("dd/MM/yyyy")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center">No trending data available.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // --- 1. LẤY DỮ LIỆU TỪ SERVER (C#) ---
        var pieData = @Html.Raw(JsonSerializer.Serialize(Model.DashboardData.ArticlesByCategory));
        var barData = @Html.Raw(JsonSerializer.Serialize(Model.DashboardData.ArticlesByDate));
        // Thêm dòng này để lấy dữ liệu Status
        var statusData = @Html.Raw(JsonSerializer.Serialize(Model.DashboardData.ArticlesByStatus));

        // --- 2. VẼ BIỂU ĐỒ TRÒN (CATEGORY) ---
        var ctxPie = document.getElementById("myPieChart");
        if(ctxPie && pieData && pieData.length > 0) {
            new Chart(ctxPie, {
                type: 'doughnut',
                data: {
                    labels: pieData.map(x => x.Label),
                    datasets: [{
                        data: pieData.map(x => x.Value),
                        backgroundColor: ['#4e73df', '#1cc88a', '#36b9cc', '#f6c23e', '#e74a3b', '#858796'],
                        hoverBorderColor: "rgba(234, 236, 244, 1)",
                    }],
                },
                options: {
                    maintainAspectRatio: false,
                    plugins: { legend: { position: 'bottom' } }
                }
            });
        }

        // --- 3. VẼ BIỂU ĐỒ CỘT (TIMELINE) ---
        var ctxBar = document.getElementById("myBarChart");
        if(ctxBar && barData && barData.length > 0) {
            new Chart(ctxBar, {
                type: 'bar',
                data: {
                    labels: barData.map(x => x.Label),
                    datasets: [{
                        label: "Articles Created",
                        backgroundColor: "#4e73df",
                        hoverBackgroundColor: "#2e59d9",
                        borderColor: "#4e73df",
                        data: barData.map(x => x.Value),
                    }],
                },
                options: {
                    maintainAspectRatio: false,
                    scales: { y: { beginAtZero: true } }
                }
            });
        }

        // --- 4. VẼ BIỂU ĐỒ STATUS (SỬA LỖI Ở ĐÂY) ---
        var ctxStatus = document.getElementById('statusChart');
        if (ctxStatus && statusData && statusData.length > 0) {
            // Xử lý dữ liệu trước khi đưa vào Chart
            var stLabels = statusData.map(x => x.Label);
            var stValues = statusData.map(x => x.Value);

            // Tạo màu: Active = Xanh, Inactive = Xám
            var stColors = statusData.map(x => x.Label === 'Active' ? '#1cc88a' : '#858796');

            new Chart(ctxStatus, {
                type: 'doughnut',
                data: {
                    labels: stLabels, // Dùng biến vừa tạo
                    datasets: [{
                        data: stValues,   // Dùng biến vừa tạo
                        backgroundColor: stColors, // Dùng biến vừa tạo
                        hoverOffset: 4
                    }]
                },
                options: {
                    maintainAspectRatio: false, // Để nó nằm gọn trong thẻ cha
                    responsive: true,
                    plugins: {
                        legend: { position: 'bottom' }
                    }
                }
            });
        }
    </script>
}