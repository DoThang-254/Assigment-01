{"@odata.context":"https://localhost:7066/api/$metadata#news(Category(),CreatedBy(),Tags())","@odata.count":1,"value":[{"NewsArticleId":"5","NewsTitle":"New Research Findings Shed Light on STEM","Headline":"New Research Findings Shed Light on STEM","CreatedDate":"2024-05-05T00:00:00+07:00","NewsContent":"Groundbreaking research conducted by the Research Department of FU has unveiled significant findings in the field of STEM, offering fresh insights that could revolutionize current understanding and practices.\r\n\r\nThe success of this research is attributed to the collaborative efforts of a multidisciplinary team, showcasing the institution's commitment to fostering cutting-edge research. The newly uncovered knowledge has the potential to influence Math, Engineering, Technology and shape future research endeavors, positioning the Research Department of FU as a leader in the advancement of STEM.\r\n\r\nThe research findings stand as a testament to the institution's dedication to impactful research and its contribution to the global knowledge base in STEM.","NewsSource":"N/A","NewsImage":null,"Views":2,"ImageUrl":null,"CategoryId":1,"NewsStatus":true,"CreatedById":2,"UpdatedById":2,"ModifiedDate":"2024-05-05T00:00:00+07:00","Category":{"CategoryId":1,"CategoryName":"Academic news","CategoryDescription":"This category can include articles about research findings, faculty appointments and promotions, and other academic-related announcements.","ParentCategoryId":1,"IsActive":true},"CreatedBy":{"AccountId":2,"AccountName":"Olivia James","AccountEmail":"OliviaJames@FUNewsManagement.org","AccountRole":2,"AccountPassword":"@1"},"Tags":[{"TagId":2,"TagName":"Technology","Note":"Technology Note"},{"TagId":3,"TagName":"Research","Note":"Research Note"},{"TagId":4,"TagName":"Innovation","Note":"Innovation Note"},{"TagId":6,"TagName":"Faculty","Note":"Faculty Achievements"}]}]}