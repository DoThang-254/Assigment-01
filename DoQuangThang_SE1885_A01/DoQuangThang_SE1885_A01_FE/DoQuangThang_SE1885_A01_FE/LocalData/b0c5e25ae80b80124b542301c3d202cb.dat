    "timestamp": "2026-02-24T17:58:57.7116436",
    "oldValues": "{\"CategoryId\":1,\"CreatedById\":2,\"CreatedDate\":\"2024-05-05T00:00:00\",\"Headline\":\"New Research Findings Shed Light on STEM\",\"ImageUrl\":null,\"ModifiedDate\":\"2024-05-05T00:00:00\",\"NewsContent\":\"Groundbreaking research conducted by the Research Department of FU has unveiled significant findings in the field of STEM, offering fresh insights that could revolutionize current understanding and practices.\\r\\n\\r\\nThe success of this research is attributed to the collaborative efforts of a multidisciplinary team, showcasing the institution\\u0027s commitment to fostering cutting-edge research. The newly uncovered knowledge has the potential to influence Math, Engineering, Technology and shape future research endeavors, positioning the Research Department of FU as a leader in the advancement of STEM.\\r\\n\\r\\nThe research findings stand as a testament to the institution\\u0027s dedication to impactful research and its contribution to the global knowledge base in STEM.\",\"NewsImage\":null,\"NewsSource\":\"N/A\",\"NewsStatus\":true,\"NewsTitle\":\"New Research Findings Shed Light on STEM\",\"UpdatedById\":2,\"Views\":2}",
    "newValues": "{\"CategoryId\":1,\"CreatedById\":2,\"CreatedDate\":\"2024-05-05T00:00:00\",\"Headline\":\"New Research Findings Shed Light on STEM\",\"ImageUrl\":null,\"ModifiedDate\":\"2024-05-05T00:00:00\",\"NewsContent\":\"Groundbreaking research conducted by the Research Department of FU has unveiled significant findings in the field of STEM, offering fresh insights that could revolutionize current understanding and practices.\\r\\n\\r\\nThe success of this research is attributed to the collaborative efforts of a multidisciplinary team, showcasing the institution\\u0027s commitment to fostering cutting-edge research. The newly uncovered knowledge has the potential to influence Math, Engineering, Technology and shape future research endeavors, positioning the Research Department of FU as a leader in the advancement of STEM.\\r\\n\\r\\nThe research findings stand as a testament to the institution\\u0027s dedication to impactful research and its contribution to the global knowledge base in STEM.\",\"NewsImage\":null,\"NewsSource\":\"N/A\",\"NewsStatus\":true,\"NewsTitle\":\"New Research Findings Shed Light on STEM\",\"UpdatedById\":2,\"Views\":3}"
